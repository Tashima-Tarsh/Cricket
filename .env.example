# Environment Configuration for STRIKE//OS Production Workstation
# Copy this file to .env and configure secrets accordingly.

# Environment Mode: "development" or "production"
CRICKET_ENV=development

# Admin Authentication Token (REQUIRED for administrative mutations and production ingestion)
# Generate a secure token: openssl rand -hex 32
CRICKET_ADMIN_TOKEN=

# Allowed CORS Origins (comma-separated; wildcard forbidden in production)
CRICKET_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8844,http://127.0.0.1:8844

# Persistent SQLite Fixture Store Path
CRICKET_FIXTURE_DB=/app/var/custom_fixtures.sqlite3

# Server Listen Port
PORT=8000

# External Cricket Provider Credentials (Optional; required for live-provider corroboration)
SPORTMONKS_API_TOKEN=
CRICKETDATA_API_KEY=
ROANUZ_PROJECT_KEY=
ROANUZ_API_KEY=

# Ollama AI Analyst Service (Optional; falls back to heuristic rule engine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b
