# ==============================================================================
# Predict-11 & Grand League Fantasy Cricket Intelligence Engine Configuration
# ==============================================================================

# 1. CricketData / CricAPI (https://cricketdata.org/)
# Used for live match discovery, confirmed squad verification, scorecards
CRICKETDATA_API_KEY=your_cricketdata_api_key_here

# 2. Sportmonks Cricket API v2.0 (https://docs.sportmonks.com/v2/cricket-api)
# Used for deep batting/bowling statistics, detailed lineups, and live scores
SPORTMONKS_API_TOKEN=your_sportmonks_api_token_here

# 3. Roanuz Cricket Match API v5 (https://sports.prod.roanuz.com/v5/docs/match-rest-api)
# Used for micro ball-by-ball telemetry, live pitch updates, toss events
ROANUZ_PROJECT_KEY=your_roanuz_project_key
ROANUZ_API_KEY=your_roanuz_api_token_here

# 4. Roanuz Fantasy API v5 (https://sports.dev.roanuz.com/v5/docs/fantasy-match-points-rest-api)
# Used for real-time fantasy score calculations and official credit valuations
# (Shares project key and API key with Roanuz Cricket API)

# 5. Cricsheet Configuration (https://cricsheet.org/downloads/)
# Local directory for cached ball-by-ball JSON match archives
CRICSHEET_DATA_DIR=data/cricsheet

# 6. Engine Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=false
